# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交）
IMAGE_API_KEY=
# OpenAI 兼容接口地址，需包含 /v1
IMAGE_API_BASE=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# 可选：1024x1024 / 1152x864 / 864x1152 等，取决于服务商
IMAGE_SIZE=1024x1024
# 可选：小红书卡片的浏览器路径与署名（小红书卡片.py 读的是环境变量，不读本文件，需要时在终端 export）
# CHROME=/usr/bin/google-chrome
# XHS_NAME=你的名字
